    {
      "parameters": {
        "text": "={{ $json.ocrText }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"vendorName\": \"ACME Supplies Ltd\",\n  \"vendorEmail\": \"billing@acme-supplies.example\",\n  \"invoiceNumber\": \"INV-2026-0042\",\n  \"invoiceDate\": \"2026-07-20\",\n  \"dueDate\": \"2026-08-19\",\n  \"purchaseOrderNumber\": \"PO-99812\",\n  \"currency\": \"USD\",\n  \"taxAmount\": 75.00,\n  \"subtotal\": 1000.00,\n  \"totalAmount\": 1075.00,\n  \"paymentTerms\": \"Net 30\",\n  \"lineItems\": [\n    { \"description\": \"Widget A\", \"quantity\": 10, \"unitPrice\": 100.00, \"amount\": 1000.00 }\n  ],\n  \"confidenceScore\": 0.95\n}",
        "options": {
          "systemPromptTemplate": "You are an expert accounts-payable data extraction assistant. Extract invoice fields from the provided OCR text. Return values exactly as they appear; use null for any field you cannot find. confidenceScore is your own 0-1 confidence in the overall extraction. Return structured JSON only."
        }
      },
      "id": "bd443ea4-efde-4e34-9877-9c4662494ea8",
      "name": "AI Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        -1248,
        480
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ex = ($('AI Extract Invoice Data').item.json.output) || $('AI Extract Invoice Data').item.json || {};\nconst v = $('Validate & Extract File').item.json;\nconst ocr = $('Extract OCR Text').item.json.ocrText || '';\n\nfunction num(x) {\n  if (x === null || x === undefined || x === '') return null;\n  const cleaned = String(x).replace(/[^0-9.-]/g, '');\n  const n = parseFloat(cleaned);\n  return isNaN(n) ? null : n;\n}\n\nconst invoiceNumber = ex.invoiceNumber || null;\nconst totalAmount = num(ex.totalAmount);\nconst lineItems = Array.isArray(ex.lineItems) ? ex.lineItems : [];\n\nreturn {\n  json: {\n    vendorName: ex.vendorName || null,\n    vendorEmail: ex.vendorEmail || null,\n    invoiceNumber: invoiceNumber,\n    invoiceDate: ex.invoiceDate || null,\n    dueDate: ex.dueDate || null,\n    poNumber: ex.purchaseOrderNumber || null,\n    currency: ex.currency || null,\n    taxAmount: num(ex.taxAmount),\n    subtotal: num(ex.subtotal),\n    totalAmount: totalAmount,\n    paymentTerms: ex.paymentTerms || null,\n    lineItems: lineItems,\n    lineItemsJson: JSON.stringify(lineItems),\n    confidenceScore: num(ex.confidenceScore),\n    hasRequired: !!(invoiceNumber && totalAmount !== null),\n    ocrText: ocr,\n    fileName: v.fileName,\n    source: v.source,\n    startMs: v.startMs,\n    startedAt: v.startedAt,\n  },\n};"
      },
