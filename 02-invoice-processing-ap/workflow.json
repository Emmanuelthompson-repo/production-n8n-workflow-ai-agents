    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst bin = (item.binary && item.binary.data) || null;\nconst fileName = bin && bin.fileName ? bin.fileName : 'unknown';\nconst mimeType = bin && bin.mimeType ? String(bin.mimeType).toLowerCase() : '';\nconst ext = fileName.indexOf('.') >= 0 ? fileName.split('.').pop().toLowerCase() : '';\nconst allowedExt = ['pdf', 'png', 'jpg', 'jpeg'];\nconst allowedMime = ['application/pdf', 'image/png', 'image/jpeg', 'image/jpg'];\nconst validExt = allowedExt.indexOf(ext) >= 0;\nconst validMime = allowedMime.indexOf(mimeType) >= 0;\nconst valid = !!bin && (validExt || validMime);\n\nlet base64 = '';\nlet visionUrl = '';\nlet visionRequest = {};\nif (valid) {\n  const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n  base64 = buffer.toString('base64');\n  const isPdf = ext === 'pdf' || mimeType === 'application/pdf';\n  if (isPdf) {\n    visionUrl = 'https://vision.googleapis.com/v1/files:annotate';\n    visionRequest = { requests: [ { inputConfig: { content: base64, mimeType: 'application/pdf' }, features: [ { type: 'DOCUMENT_TEXT_DETECTION' } ] } ] };\n  } else {\n    visionUrl = 'https://vision.googleapis.com/v1/images:annotate';\n    visionRequest = { requests: [ { image: { content: base64 }, features: [ { type: 'DOCUMENT_TEXT_DETECTION' } ] } ] };\n  }\n}\n\nreturn {\n  json: {\n    valid: valid,\n    fileName: fileName,\n    mimeType: mimeType,\n    fileExtension: ext,\n    source: (item.json && item.json.source) || 'unknown',\n    base64: base64,\n    visionUrl: visionUrl,\n    visionRequest: visionRequest,\n    startMs: Date.now(),\n    startedAt: new Date().toISOString(),\n    validationError: valid ? '' : ('Unsupported or missing file: ' + fileName + ' (' + mimeType + ')'),\n  },\n  binary: item.binary,\n};"
      },
