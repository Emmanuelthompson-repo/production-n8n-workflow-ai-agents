    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json || {};\nlet text = '';\ntry {\n  const resp = r.responses && r.responses[0];\n  if (resp) {\n    if (resp.fullTextAnnotation && resp.fullTextAnnotation.text) {\n      text = resp.fullTextAnnotation.text;\n    } else if (resp.responses && resp.responses[0] && resp.responses[0].fullTextAnnotation) {\n      text = resp.responses[0].fullTextAnnotation.text || '';\n    }\n  }\n} catch (e) {\n  text = '';\n}\nreturn { json: { ocrText: text } };"
      },
      "id": "8b090246-dd1d-476a-9892-73d5a9424e47",
      "name": "Extract OCR Text",
