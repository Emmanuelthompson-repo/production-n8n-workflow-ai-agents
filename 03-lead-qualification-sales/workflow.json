    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $(\"Check Duplicate\").item.json;\nlet ai = ($json.output && $json.output[0] && $json.output[0].content && $json.output[0].content[0]) ? $json.output[0].content[0].text : {};\nif (typeof ai === \"string\") { try { ai = JSON.parse(ai); } catch (e) { ai = {}; } }\nai = ai || {};\nconst parts = (lead.fullName || \"\").split(\" \");\nconst firstName = parts[0] || \"\";\nconst lastName = parts.slice(1).join(\" \");\nreturn Object.assign({}, lead, {\n  firstName, lastName,\n  lead_score: (ai.lead_score !== undefined && ai.lead_score !== null) ? ai.lead_score : 0,\n  lead_category: ai.lead_category || \"Cold\",\n  priority: ai.priority || \"Low\",\n  business_type: ai.business_type || \"\",\n  buying_intent: ai.buying_intent || \"\",\n  urgency: ai.urgency || \"\",\n  complexity: ai.complexity || \"\",\n  recommended_service: ai.recommended_service || lead.serviceInterested || \"\",\n  sales_summary: ai.sales_summary || \"\",\n  recommended_action: ai.recommended_action || \"\",\n});"
      },
