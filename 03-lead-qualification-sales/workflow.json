    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst total = rows.length;\nlet hot = 0, warm = 0, cold = 0, converted = 0, scoreSum = 0, scoreCount = 0;\nconst sources = {}; const industries = {};\nfor (const r of rows) {\n  const cat = String(r.lead_category || \"\").toLowerCase();\n  if (cat === \"hot\") hot++; else if (cat === \"warm\") warm++; else if (cat === \"cold\") cold++;\n  const st = String(r.status || \"\").toLowerCase();\n  if (st === \"customer\" || st === \"converted\") converted++;\n  const sc = parseFloat(r.lead_score); if (!isNaN(sc)) { scoreSum += sc; scoreCount++; }\n  const src = r.source || \"Unknown\"; sources[src] = (sources[src] || 0) + 1;\n  const ind = r.industry || \"Unknown\"; industries[ind] = (industries[ind] || 0) + 1;\n}\nconst average_lead_score = scoreCount ? Math.round(scoreSum / scoreCount) : 0;\nconst conversion_rate_pct = total ? Math.round((converted / total) * 10000) / 100 : 0;\nreturn [{ json: {\n  snapshot_date: new Date().toISOString(),\n  total_leads: total, hot_leads: hot, warm_leads: warm, cold_leads: cold,\n  converted_leads: converted, conversion_rate_pct, average_lead_score,\n  pipeline_open: total - converted,\n  lead_sources: JSON.stringify(sources), industries: JSON.stringify(industries),\n} }];"
      },
