    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst now = new Date();\nconst out = [];\nfor (const r of rows) {\n  const status = String(r.status || r.Status || \"\").toLowerCase();\n  if (status === \"customer\" || status === \"converted\" || status === \"closed\") continue;\n  const createdRaw = r.created_date || r.timestamp || r.submittedAt;\n  if (!createdRaw) continue;\n  const created = new Date(createdRaw);\n  if (isNaN(created.getTime())) continue;\n  const days = Math.floor((now.getTime() - created.getTime()) / 86400000);\n  const name = r.full_name || r.fullName || \"there\";\n  const company = r.company_name || r.companyName || \"your company\";\n  let subject = \"\"; let body = \"\"; let type = \"\";\n  if (days === 2) {\n    type = \"resource\";\n    subject = \"A helpful resource for \" + company;\n    body = \"<p>Hi \" + name + \",</p><p>While we prepare your proposal, here is a resource we think you will find useful.</p>\";\n  } else if (days === 5) {\n    type = \"case_study\";\n    subject = \"How we helped a company like \" + company;\n    body = \"<p>Hi \" + name + \",</p><p>Here is a short case study showing results we delivered for a similar business.</p>\";\n  } else if (days === 10) {\n    type = \"reminder\";\n    subject = \"Following up on your enquiry\";\n    body = \"<p>Hi \" + name + \",</p><p>Just checking in — are you still interested in moving forward? Reply any time and we will help.</p>\";\n  } else { continue; }\n  const email = r.email || r.Email;\n  if (!email) continue;\n  out.push({ json: { email, name, followup_type: type, subject, body } });\n}\nreturn out;"
      },
