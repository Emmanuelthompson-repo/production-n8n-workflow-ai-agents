        "jsCode": "const lead = $(\"Normalize & Validate Lead\").item.json;\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst email = (lead.email || \"\").toLowerCase();\nconst match = rows.find(r => String(r.email || r.Email || \"\").toLowerCase() === email);\nreturn [{ json: Object.assign({}, lead, { isDuplicate: !!match, existingRow: match || null, duplicateCheckedAt: new Date().toISOString() }) }];"
