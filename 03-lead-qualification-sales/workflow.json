    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $(\"Merge Qualification\").item.json;\nconst industry = (d.industry || \"\").toLowerCase();\nlet bd = \"\";\nfor (const ch of String(d.budget || \"\")) { if (ch >= \"0\" && ch <= \"9\") bd += ch; }\nconst budgetNumeric = bd ? parseInt(bd, 10) : 0;\nlet assignedTo = \"General Sales\";\nlet team = \"General Sales\";\nif (industry.indexOf(\"health\") !== -1) { assignedTo = \"Healthcare Sales\"; team = \"Healthcare\"; }\nelse if (industry.indexOf(\"ngo\") !== -1 || industry.indexOf(\"non-profit\") !== -1 || industry.indexOf(\"nonprofit\") !== -1) { assignedTo = \"NGO Consultant\"; team = \"NGO\"; }\nelse if (industry.indexOf(\"real estate\") !== -1 || industry.indexOf(\"realestate\") !== -1 || industry.indexOf(\"property\") !== -1) { assignedTo = \"Real Estate Team\"; team = \"Real Estate\"; }\nconst highValue = budgetNumeric >= 50000 || d.lead_category === \"Hot\" || d.priority === \"High\";\nif (highValue) { assignedTo = \"Senior Consultant\"; team = \"Senior Consultants\"; }\nreturn Object.assign({}, d, { budgetNumeric, assignedTo, team, status: \"New\", ownerAssignedAt: new Date().toISOString() });"
      },
