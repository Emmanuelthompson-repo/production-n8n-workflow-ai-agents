    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $json.body || $json;\nconst s = (v) => (v === undefined || v === null) ? \"\" : String(v).trim();\nconst fullName = s(src.fullName || src.full_name || src.name);\nconst companyName = s(src.companyName || src.company_name || src.company);\nconst email = s(src.email).toLowerCase();\nconst phone = s(src.phone || src.phoneNumber || src.phone_number);\nconst country = s(src.country);\nconst industry = s(src.industry);\nconst companySize = s(src.companySize || src.company_size);\nconst budget = s(src.budget);\nconst projectDescription = s(src.projectDescription || src.project_description || src.message || src.description);\nconst serviceInterested = s(src.serviceInterested || src.service_interested || src.service);\nconst source = s(src.source) || \"Webhook\";\nconst submittedAt = s(src.submissionTimestamp || src.timestamp) || new Date().toISOString();\nconst errors = [];\nif (!fullName) errors.push(\"Full name is required\");\nif (!email) errors.push(\"Email is required\");\nif (!projectDescription) errors.push(\"Project description is required\");\nconst at = email.indexOf(\"@\");\nconst dot = email.lastIndexOf(\".\");\nconst emailOk = at > 0 && dot > at + 1 && dot < email.length - 1;\nif (email && !emailOk) errors.push(\"Email format is invalid\");\nlet digits = \"\";\nfor (const ch of phone) { if (ch >= \"0\" && ch <= \"9\") digits += ch; }\nconst phoneValid = digits.length >= 7 && digits.length <= 15;\nif (phone && !phoneValid) errors.push(\"Phone number is invalid\");\nlet spamScore = 0;\nconst desc = projectDescription.toLowerCase();\nconst spamWords = [\"viagra\",\"casino\",\"bitcoin\",\"free money\",\"seo services\",\"click here\",\"loan offer\"];\nfor (const w of spamWords) { if (desc.indexOf(w) !== -1) spamScore++; }\nconst linkCount = desc.split(\"http\").length - 1;\nif (linkCount >= 3) spamScore++;\nconst disposable = [\"mailinator.com\",\"tempmail.com\",\"guerrillamail.com\",\"10minutemail.com\"];\nconst emailDomain = email.split(\"@\")[1] || \"\";\nif (disposable.indexOf(emailDomain) !== -1) spamScore++;\nconst isSpam = spamScore >= 2;\nif (isSpam) errors.push(\"Submission flagged as spam\");\nconst valid = errors.length === 0;\nreturn { valid, isSpam, errors, fullName, companyName, email, phone, phoneValid, country, industry, companySize, budget, projectDescription, serviceInterested, source, submittedAt };"
      },
