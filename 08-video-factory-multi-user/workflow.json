    {
      "parameters": {
        "jsCode": "// ---- USERS: add one entry per person. hash = sha256(\"username:accesscode\") ----\n// Make a hash on the VM:  printf '%s' 'username:ACCESS-CODE' | sha256sum\n// channels: ['*'] = all channels, or list the exact dropdown names this person may use.\n// max_per_day = daily allowance in units: a Short costs 1, a Long costs 4.\nconst USERS = {\n  owner: {\n    hash: 'fcb1f292eca8f42b7053b5a044787cd676500b47ef9b41eba3d41534aca224fa',\n    email: 'you@example.com',\n    channels: ['*'],\n    max_per_day: 100,\n  },\n  // friend: {\n  //   hash: 'PASTE_SHA256_HASH_HERE',\n  //   email: 'friend@example.com',\n  //   channels: ['General / Custom', 'Auto (my own channel)'],\n  //   max_per_day: 4,\n  // },\n};\n\nfunction sha256(str) {\n  const K = [0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];\n  const bytes = [];\n  for (const ch of unescape(encodeURIComponent(str))) bytes.push(ch.charCodeAt(0));\n  const bitLen = bytes.length * 8;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  const hi = Math.floor(bitLen / 4294967296), lo = bitLen >>> 0;\n  for (const v of [hi, lo]) for (let s = 24; s >= 0; s -= 8) bytes.push((v >>> s) & 255);\n  let h = [0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];\n  const rotr = (x, n) => (x >>> n) | (x << (32 - n));\n  for (let i = 0; i < bytes.length; i += 64) {\n    const w = new Array(64);\n    for (let t = 0; t < 16; t++) w[t] = (bytes[i+4*t]<<24)|(bytes[i+4*t+1]<<16)|(bytes[i+4*t+2]<<8)|bytes[i+4*t+3];\n    for (let t = 16; t < 64; t++) {\n      const s0 = rotr(w[t-15],7) ^ rotr(w[t-15],18) ^ (w[t-15] >>> 3);\n      const s1 = rotr(w[t-2],17) ^ rotr(w[t-2],19) ^ (w[t-2] >>> 10);\n      w[t] = (w[t-16] + s0 + w[t-7] + s1) | 0;\n    }\n    let [a,b,c,d,e,f,g,hh] = h;\n    for (let t = 0; t < 64; t++) {\n      const S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);\n      const ch = (e & f) ^ (~e & g);\n      const t1 = (hh + S1 + ch + K[t] + w[t]) | 0;\n      const S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const t2 = (S0 + maj) | 0;\n      hh = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;\n    }\n    h = [(h[0]+a)|0,(h[1]+b)|0,(h[2]+c)|0,(h[3]+d)|0,(h[4]+e)|0,(h[5]+f)|0,(h[6]+g)|0,(h[7]+hh)|0];\n  }\n  return h.map(x => (x >>> 0).toString(16).padStart(8, '0')).join('');\n}\n\nconst item = $input.first().json;\nconst username = String(item['Username'] || '').trim().toLowerCase();\nconst code = String(item['Access code'] || '');\nconst channel = String(item['Channel'] || '');\nconst user = Object.prototype.hasOwnProperty.call(USERS, username) ? USERS[username] : null;\n\nconst sd = $getWorkflowStaticData('global');\nsd.fails = sd.fails || {};\nsd.usage = sd.usage || {};\nconst now = Date.now();\nconst today = new Date().toISOString().slice(0, 10);\n\nconst out = Object.assign({}, item);\ndelete out['Access code'];\nout.username = username;\nout.authorized = false;\nout.reason = '';\nout.user_email = '';\nout.notify_email = user ? user.email : '';\nout.owner_email = (USERS.owner && USERS.owner.email) || '';\n\n// lock out after 5 wrong codes in an hour\nconst f = (sd.fails[username] || []).filter(t => now - t < 3600000);\nif (!user) {\n  out.reason = 'Unknown username.';\n} else if (f.length >= 5) {\n  out.reason = 'Too many wrong access codes. Try again in an hour.';\n  out.notify_email = '';\n} else if (user.hash.startsWith('PASTE_') || sha256(username + ':' + code) !== user.hash) {\n  f.push(now);\n  sd.fails[username] = f;\n  out.reason = 'Wrong access code.';\n} else if (!(user.channels.includes('*') || user.channels.includes(channel))) {\n  out.reason = 'Your account is not allowed to use the channel \"' + channel + '\".';\n} else {\n  const cost = String(item['Format'] || '').toLowerCase() === 'long' ? 4 : 1;\n  const limit = user.max_per_day || 4;\n  const u = sd.usage[username] && sd.usage[username].date === today ? sd.usage[username] : { date: today, count: 0 };\n  if (u.count + cost > limit) {\n    out.reason = 'Daily allowance reached (' + limit + ' units a day; a Short costs 1 and a Long costs 4). Try again tomorrow.';\n  } else {\n    u.count += cost;\n    sd.usage[username] = u;\n    sd.fails[username] = [];\n    out.authorized = true;\n    out.user_email = user.email;\n    out.cost = cost;\n  }\n}\nreturn [{ json: out }];\n"
      },
