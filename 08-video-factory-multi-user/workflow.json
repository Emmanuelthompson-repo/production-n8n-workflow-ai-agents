        "jsCode": "// Join the form data with the worker's queue size, and refund the user's allowance if the server is busy.\nconst base = $('Check Login').first().json;\nconst h = ($input.first() && $input.first().json) || {};\nconst activeJobs = Array.isArray(h.active) ? h.active.length : 0;\nconst MAX_ACTIVE = 4;   // how many jobs may be queued or running before new requests are turned away\nconst busy = activeJobs >= MAX_ACTIVE;\nif (busy) {\n  const sd = $getWorkflowStaticData('global');\n  const u = sd.usage && sd.usage[base.username];\n  if (u) u.count = Math.max(0, u.count - (base.cost || 1));\n}\nreturn [{ json: Object.assign({}, base, { busy: busy, active_jobs: activeJobs, reason: busy ? 'The server is busy right now (' + activeJobs + ' jobs ahead). Nothing was used from your allowance. Please submit again in 30 to 60 minutes.' : base.reason }) }];"
