    {
      "parameters": {
        "formTitle": "Video Factory",
        "formDescription": "Sign in with your username and access code, then request a Short (~50s, vertical) or a Long video (16:9). The script is emailed to you for approval before anything renders.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Username",
              "placeholder": "your username",
              "requiredField": true
            },
            {
              "fieldLabel": "Access code",
              "fieldType": "password",
              "requiredField": true
            },
            {
              "fieldLabel": "Channel",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Dark Truth Shorts"
                  },
                  {
                    "option": "Shocking History Facts"
                  },
                  {
                    "option": "Mind Twist Facts"
                  },
                  {
                    "option": "Weird Science Daily"
                  },
                  {
                    "option": "Money Moves Shorts"
                  },
                  {
                    "option": "AI Edge News"
                  },
                  {
                    "option": "Fear Files"
                  },
                  {
                    "option": "Career Unlock"
                  },
                  {
                    "option": "Deep Dive True Crime"
                  },
                  {
                    "option": "Untold History"
                  },
                  {
                    "option": "General / Custom"
                  },
                  {
                    "option": "Auto (my own channel)"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Format",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Short"
                  },
                  {
                    "option": "Long"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Topic",
              "placeholder": "Leave blank and the channel memory picks the next topic. For General / Custom, always enter a topic."
            },
            {
              "fieldLabel": "Target Length (minutes)",
              "fieldType": "number",
              "placeholder": "Long only (default 12)"
            },
            {
              "fieldLabel": "Notes / Special Instructions",
              "fieldType": "textarea",
              "placeholder": "Angle, audience, tone or visual style you want (important for General / Custom)"
            },
            {
              "fieldLabel": "Sources (AI Edge News: required)",
              "fieldType": "textarea",
              "placeholder": "Paste article URLs (one per line) or the text. Only needed for channels that report from sources."
            },
            {
              "fieldLabel": "Script Review Required?",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
