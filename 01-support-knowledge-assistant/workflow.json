        "operation": "executeQuery",
        "query": "INSERT INTO support_tickets (customer_id, session_id, category, priority, ai_summary, suggested_resolution, status, created_at)\nVALUES ($1, $2, $3, $4, $5, $6, 'open', NOW())\nRETURNING id AS ticket_id, priority, status;",
