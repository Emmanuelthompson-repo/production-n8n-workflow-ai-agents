      "id": "c021ff49-f5c5-4152-b45f-f3c97555974c",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -3296,
        384
      ],
      "notes": "Captures the standard support envelope (name, email, phone, channel, message, timestamp, session id) into a stable shape used by the rest of the pipeline."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.customer_message || \"\").toString();\n// Sanitize: strip control characters and trim.\nconst clean = raw.replace(/[\\u0000-\\u001F\\u007F]/g, \" \").replace(/\\s+/g, \" \").trim();\nlet isValid = true;\nlet reason = \"\";\nif (!clean) { isValid = false; reason = \"empty_message\"; }\nelse if (clean.length > 4000) { isValid = false; reason = \"message_too_long\"; }\nconst urlCount = (clean.match(/https?:\\/\\//gi) || []).length;\nif (isValid && urlCount >= 5) { isValid = false; reason = \"spam_excessive_links\"; }\nconst repeated = /(.)\\1{20,}/.test(clean);\nif (isValid && repeated) { isValid = false; reason = \"spam_repeated_characters\"; }\n// Attachment validation (type only; size limits enforced by the chat widget).\nconst bin = $binary || {};\nconst files = Object.keys(bin);\nconst allowedPrefixes = [\"image/\", \"application/pdf\"];\nlet attachmentsOk = true;\nfor (const key of files) {\n  const type = (bin[key] && bin[key].mimeType) || \"\";\n  if (!allowedPrefixes.some((p) => type.indexOf(p) === 0)) { attachmentsOk = false; }\n}\nif (isValid && !attachmentsOk) { isValid = false; reason = \"unsupported_attachment\"; }\nreturn { json: { ...$json, customer_message: clean, is_valid: isValid, validation_reason: reason, attachment_count: files.length } };"
      },
      "id": "5c973397-9a2b-45cd-8a2a-dc859ecf2ec5",
      "name": "Validate & Sanitize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3072,
        384
      ],
      "notes": "Step 1 — rejects empty messages, spam (excessive links/repeated chars), oversized text and unsupported attachments. Also sanitizes control characters (Security: input sanitization)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "88f7ed36-4506-40ef-bd21-3c185b35c0ba",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -2848,
        384
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customers (session_id, channel, name, email, phone, tier, account_status, created_at, last_contact)\nVALUES ($1, $2, NULLIF($3, ''), NULLIF($4, ''), NULLIF($5, ''), 'standard', 'active', NOW(), NOW())\nON CONFLICT (session_id) DO UPDATE SET\n  last_contact = NOW(),\n  name = COALESCE(customers.name, EXCLUDED.name),\n  email = COALESCE(customers.email, EXCLUDED.email),\n  phone = COALESCE(customers.phone, EXCLUDED.phone)\nRETURNING id AS customer_id, session_id, name, email, phone, tier, account_status, created_at, last_contact;",
        "options": {
          "queryReplacement": "={{ [$json.session_id, $json.channel, $json.customer_name, $json.customer_email, $json.customer_phone] }}"
        }
      },
      "id": "64d33e79-15aa-43eb-be89-dfe0cf5d4545",
      "name": "Identify or Create Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -2624,
        96
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR postgres credential"
        }
      },
      "notes": "Step 2 — upsert-by-session identifies an existing customer (returning id, tier, status, purchase/account fields) or creates a new profile in one atomic, injection-safe query."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this customer support message.\n\nCustomer tier: {{ $json.tier }}\nAccount status: {{ $json.account_status }}\nMessage: \"{{ $('Normalize Input').item.json.customer_message }}\"",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a support triage classifier. Analyze the message and return intent, category, urgency, sentiment, language and a confidence score. Be precise and choose the single best category."
        }
      },
      "id": "1bf29025-dd36-405a-b0d3-fe1cd4cbe16c",
      "name": "Intent Analysis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -2336,
        96
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "Step 3 — structured intent/category/urgency/sentiment/language/confidence as JSON."
    },
    {
      "parameters": {
        "contextWindowLength": 12
      },
      "id": "57ea7b34-22fa-4c7e-8b9a-3b4a0a47c29e",
      "name": "Intent Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        -2272,
        320
      ],
      "notes": "Conversation history for the intent agent, keyed by chat session id."
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"intent\":{\"type\":\"string\",\"description\":\"Short summary of what the customer wants\"},\"category\":{\"type\":\"string\",\"enum\":[\"Billing\",\"Technical Support\",\"Sales\",\"Product Question\",\"Complaint\",\"Feature Request\",\"Refund\",\"General Inquiry\"]},\"urgency\":{\"type\":\"string\",\"enum\":[\"low\",\"medium\",\"high\",\"critical\"]},\"sentiment\":{\"type\":\"string\",\"enum\":[\"positive\",\"neutral\",\"negative\"]},\"language\":{\"type\":\"string\",\"description\":\"ISO language name, e.g. English\"},\"confidence\":{\"type\":\"number\",\"description\":\"Classification confidence 0-100\"}},\"required\":[\"intent\",\"category\",\"urgency\",\"sentiment\",\"language\",\"confidence\"],\"additionalProperties\":false}"
      },
      "id": "0634343f-059b-4d43-8001-ee8667e0cfdc",
      "name": "Intent Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -2144,
        320
