      "id": "f373a848-23f5-420c-b59e-6d2c3e5cf180",
      "name": "Knowledge Search",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        -1936,
        96
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR postgres credential"
        }
      },
      "notes": "Step 4 — similarity search over the company knowledge base (FAQs, docs, policies, SOPs...) stored as vectors in PostgreSQL/PGVector."
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json).filter((j) => j && Object.keys(j).length > 0);\nconst LF = String.fromCharCode(10);\nconst parts = rows.map((d, idx) => {\n  const text = (d.document && d.document.pageContent) || d.pageContent || d.text || d.content || JSON.stringify(d);\n  return \"[Doc \" + (idx + 1) + \"] \" + text;\n});\nconst context = parts.length ? parts.join(LF + LF) : \"NO_RELEVANT_KNOWLEDGE_FOUND\";\nreturn [{ json: { kb_context: context, kb_count: parts.length } }];"
      },
      "id": "4c6f145a-8bc9-4b15-adfc-69d51e56fe92",
      "name": "Aggregate Knowledge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1584,
        96
      ],
      "notes": "Step 4 — collapses the retrieved documents into a single grounding context string for the response agent."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer message: \"{{ $('Normalize Input').item.json.customer_message }}\"\nDetected category: {{ $('Intent Analysis').item.json.output.category }}\nUrgency: {{ $('Intent Analysis').item.json.output.urgency }}\n\nKnowledge base excerpts:\n{{ $json.kb_context }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a professional, friendly customer support assistant. Answer using ONLY the knowledge base excerpts provided. NEVER invent information. If the excerpts do not contain the answer (or say NO_RELEVANT_KNOWLEDGE_FOUND), say you are not certain, ask a clarifying follow-up question, and set a low confidence. Be concise, reference company policies where relevant. Return response, a confidence score (0-100) reflecting how well the knowledge answered the question, and a suggested next_action for the support team."
        }
      },
      "id": "507c3f3d-b6a0-43a4-87f7-4871f6d834a7",
      "name": "Generate Response",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1296,
        96
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "Step 5 — grounded response generation. Confidence reflects answer quality and drives the escalation decision."
    },
    {
      "parameters": {
        "contextWindowLength": 12
      },
      "id": "34d2bf3c-4b24-4b63-91c8-d2c8a3ffe9ab",
      "name": "Response Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        -1232,
        320
      ],
      "notes": "Conversation history for the response agent, keyed by the same chat session id for context continuity."
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"string\",\"description\":\"The reply to the customer, grounded ONLY in the provided knowledge\"},\"confidence\":{\"type\":\"number\",\"description\":\"How well the knowledge answered the question, 0-100\"},\"next_action\":{\"type\":\"string\",\"description\":\"Suggested next action for the support team\"}},\"required\":[\"response\",\"confidence\",\"next_action\"],\"additionalProperties\":false}"
      },
      "id": "93b99d21-ae56-452f-9911-7da7f0388670",
