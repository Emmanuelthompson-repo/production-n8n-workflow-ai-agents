    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sid",
              "name": "session_id",
              "value": "={{ $json.sessionId || $json.session_id || $execution.id }}",
              "type": "string"
            },
            {
              "id": "msg",
              "name": "customer_message",
              "value": "={{ $json.chatInput || $json.message || \"\" }}",
              "type": "string"
            },
            {
              "id": "chn",
              "name": "channel",
              "value": "website_chat",
              "type": "string"
            },
            {
              "id": "nam",
              "name": "customer_name",
              "value": "={{ $json.name || \"\" }}",
              "type": "string"
            },
            {
              "id": "eml",
              "name": "customer_email",
              "value": "={{ $json.email || \"\" }}",
              "type": "string"
            },
            {
              "id": "phn",
              "name": "customer_phone",
              "value": "={{ $json.phone || \"\" }}",
              "type": "string"
            },
            {
